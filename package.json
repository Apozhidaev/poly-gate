{
  "name": "poly-gate",
  "version": "0.1.0",
  "description": "Gateway for Polymarket APIs (Gamma, Data, CLOB) with centralized rate limiting and L2 auth",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "derive-creds": "tsx scripts/derive-creds.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@polymarket/clob-client-v2": "^0.2.7",
    "@sinclair/typebox": "^0.34.14",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fflate": "^0.8.3",
    "pino": "^9.6.0",
    "viem": "^2.22.8",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^3.0.2"
  }
}
