# Path to the YAML config file (defaults to ./config.yaml if unset).
POLY_GATE_CONFIG=./config.yaml

# Used only by `npm run derive-wallet`:
# MNEMONIC="word1 word2 ... word12"
# ACCOUNT_INDEX=0
# ADDRESS_INDEX=0
# PASSPHRASE=

# Used only by `npm run derive-creds`:
# PRIVATE_KEY=0x...
# CLOB_HOST=https://clob.polymarket.com
# CHAIN_ID=137
# NONCE=0
